MPESA_ENV=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
PORT=
APP_URL=
SESSION_SECRET=

# Used to send password-reset emails (and the contact form). A Gmail
# account with an "app password" works well here.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# "Sign in with Google" for customers. Create an OAuth Client ID
# (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add this site's URL under "Authorized JavaScript origins".
# Only the Client ID is needed — never put the Client Secret here,
# it's not used by this sign-in method.
GOOGLE_CLIENT_ID=


# IMPORTANT on Render: mount a Persistent Disk at /data and set this to /data.
PHYNEX_DATA_DIR=
