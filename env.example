MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://your-public-https-domain.example/api/mpesa/callback
PORT=3000
APP_URL=https://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Used to send password-reset emails (and the contact form). A Gmail
# account with an "app password" works well here.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# "Sign in with Google" for customers. Create an OAuth Client ID
# (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add this site's URL under "Authorized JavaScript origins".
# Only the Client ID is needed — never put the Client Secret here,
# it's not used by this sign-in method.
GOOGLE_CLIENT_ID=


# Customer authentication additions:
# APP_URL is already above and must be the real public HTTPS URL in production.
# EMAIL_* above are used for email verification and password-reset emails.

# Optional real Kenyan SMS OTP verification.
# When all three are set, PHYNEX requires phone verification before login.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Optional override for Africa's Talking's messaging endpoint:
# AT_SMS_URL=https://api.africastalking.com/version1/messaging

# Optional: only if the browser/API is hosted on separate origins.
# Use exact origins, comma-separated. Do not use * with credentialed cookies.
# ALLOWED_ORIGINS=https://shop.example
